#!/usr/bin/env bash
declare -rx PS4='+${SECONDS}s $(basename ${BASH_SOURCE[0]:-${FUNCNAME[0]:-"Unknown"}})[${LINENO}]: '
set -x
date
#
#-----------------------------------------------------------------------
# Specify Execution Areas
#-----------------------------------------------------------------------
#
export HOMErrfs=${HOMErrfs} #comes from the workflow at runtime
export EXECrrfs=${EXECrrfs:-${HOMErrfs}/exec}
export FIXrrfs=${FIXrrfs:-${HOMErrfs}/fix}
export PARMrrfs=${PARMrrfs:-${HOMErrfs}/parm}
export USHrrfs=${USHrrfs:-${HOMErrfs}/ush}
#
#-----------------------------------------------------------------------
# Obtain unique process id (pid) and create the run directory (DATA).
#-----------------------------------------------------------------------
#
export UMBRELLA_PREP_IC_DATA=${UMBRELLA_PREP_IC_DATA:-${DATAROOT}/${RUN}_prep_ic_${cyc}_${rrfs_ver}/${WGF}}
enkf_type=${ENKF_TYPE:-${ENS_DA_TYPE:-${ENKF_SOLVER:-"GETKF"}}}
enkf_task_type=${ENKF_TASK_TYPE:-${GETKF_TYPE}}
enkf_onestep=${ENKF_ONESTEP:-${GETKF_ONESTEP:-"false"}}
if [[ "${enkf_type^^}" == "LETKF" || "${enkf_onestep^^}" == "TRUE" ]]; then  # LETKF or one-step ENKF
  observerstr=""
  if [[ "${enkf_type^^}" == "LETKF" || "${enkf_task_type}" == "observer_solver" || -z "${enkf_task_type}" ]]; then
    export TYPESTR=""
  else  # post
    export TYPESTR="_${enkf_task_type}"
  fi
else  # observer, solver, post run separately
  observerstr="_observer"
  export TYPESTR="_${enkf_task_type}"
fi
export UMBRELLA_ENKF_DATA=${UMBRELLA_ENKF_DATA:-${UMBRELLA_GETKF_DATA:-${DATAROOT}/${RUN}_enkf${TYPESTR}_${cyc}_${rrfs_ver}/${WGF}}}
export UMBRELLA_GETKF_DATA=${UMBRELLA_GETKF_DATA:-${UMBRELLA_ENKF_DATA}}
export UMBRELLA_ENKF_OBSERVER_DATA=${UMBRELLA_ENKF_OBSERVER_DATA:-${UMBRELLA_GETKF_OBSERVER_DATA:-${DATAROOT}/${RUN}_enkf${observerstr}_${cyc}_${rrfs_ver}/${WGF}}}
export UMBRELLA_GETKF_OBSERVER_DATA=${UMBRELLA_GETKF_OBSERVER_DATA:-${UMBRELLA_ENKF_OBSERVER_DATA}}
export pid=${pid:-$$}
export jobid=${jobid:-enkf${TYPESTR}_${cyc}}
export DATA=${DATA:-${UMBRELLA_ENKF_DATA}/${jobid}}

if [[ -d "${DATA}" ]]; then # remove the ${DATA} directory if existed
  rm -rf "${DATA}"
fi
mkdir -p "${DATA}"
#
#-----------------------------------------------------------------------
# Define COM directories
#-----------------------------------------------------------------------
#
#export COMINgfs=${COMINgfs:-$(compath.py ${envir}/gfs/${gfs_ver})}
export COMINrrfs=${COMINrrfs:-$(compath.py "${envir}/rrfs/${rrfs_ver}")}
export COMOUT=${COMOUT:-$(compath.py -o "${NET}/${rrfs_ver}/${RUN}.${PDY}/${cyc}")}
mkdir -p "${COMOUT}/enkf${TYPESTR}/${WGF}"
mkdir -p "${COMOUT}/getkf${TYPESTR}/${WGF}"
#
#----------------------------------------
# Execute the script.
#----------------------------------------
export pgmout="${DATA}/OUTPUT.$$"
if [[ -f "${HOMErrfs}/scripts/exrrfs_enkf.sh" ]]; then
  "${HOMErrfs}"/scripts/exrrfs_enkf.sh
else
  "${HOMErrfs}"/scripts/exrrfs_getkf.sh
fi
export err=$?; err_chk

if [[ -e "${pgmout}" ]]; then
  cat "${pgmout}"
fi
#
#----------------------------------------
# Remove the Temporary working directory
#----------------------------------------
[[ "${KEEPDATA^^}" == "NO" ]] && rm -rf "${DATA}"
#
date
echo "JOB ${jobid:-} HAS COMPLETED NORMALLY!"
exit 0
